# Copia este archivo como .env y cambia los valores. NO subas .env a ningún repositorio.
VIEWER_USER=cambia-este-usuario
# Una contraseña larga y única (genera una con: python -c "import secrets; print(secrets.token_urlsafe(24))")
VIEWER_PASSWORD=
# Carpeta del servidor donde están las canciones (la llena deploy/push_songs.ps1)
SONGS_PATH=/opt/transcriptor/songs
# Puerto local del servidor al que apunta el proxy inverso
HOST_PORT=8000
